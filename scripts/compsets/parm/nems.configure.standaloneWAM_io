EARTH_component_list:       ATM AIO05 AIO10

# WAM #
ATM_model:                  wam
ATM_petlist_bounds:         $atm_petlist_bounds
ATM_attributes::
  Verbosity = max
::
# AIO05 #
AIO05_model:                  swio
AIO05_petlist_bounds:         $atm_petlist_bounds
AIO05_attributes::
  Verbosity = max
  ConfigFile = swio.wam05.rc
::
# AIO10 #
AIO10_model:                  swio
AIO10_petlist_bounds:         $atm_petlist_bounds
AIO10_attributes::
  Verbosity = max
  ConfigFile = swio.wam10.rc
::

runSeq::
  @${AIO05_CADENCE}.0
    @${AIO05_CADENCE}.0
      @${DELTIM}.0
        ATM
      @
      ATM -> AIO05
      AIO05
    @
    ATM -> AIO10
    AIO10
  @
::
